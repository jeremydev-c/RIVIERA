# Copy to .env for local use. On Vercel, add these under Settings > Environment Variables.
ADMIN_PASSWORD=choose-a-long-password
# Your MongoDB connection string. The site uses its own database called grand_riviera.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
# Optional: your final address, used for WhatsApp and social link previews.
SITE_URL=https://example.com
PORT=3000
